# Optional OpenAI integration. Leave disabled for deterministic local analysis.
USE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# API safeguards.
MAX_REQUEST_BYTES=1000000
MAX_CHAT_CHARS=100000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
